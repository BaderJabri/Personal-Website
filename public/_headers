# Cloudflare Pages headers. Next's static export writes OG images without an extension,
# so Pages would otherwise serve them as application/octet-stream.
/opengraph-image
  Content-Type: image/png
/projects/*/opengraph-image
  Content-Type: image/png
/downloads/*
  Content-Type: application/octet-stream
  Content-Disposition: attachment
  X-Content-Type-Options: nosniff
